<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Notima.Stride</RootNamespace>
    <DefineConstants>STRIDE_PLATFORM_DESKTOP</DefineConstants>
    <StridePlatform>Linux</StridePlatform>
    <StrideGraphicsApi>OpenGL</StrideGraphicsApi>
    <StrideGraphicsApiDependent>false</StrideGraphicsApiDependent>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notima.Stride\Notima.Stride.csproj" />
  </ItemGroup>
</Project>

